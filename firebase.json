{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      ".env",
      ".env.*",
      "mail.js",
      "*.pem",
      "*.key",
      "*service-account*.json",
      "*.log",
      "**/*.log",
      ".next/cache/**",
      ".next/trace/**",
      ".next/dev/**",
      ".next/diagnostics/**",
      ".next/types/**"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": [
    {
      "target": "production",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": true,
      "rewrites": [
        {
          "source": "**",
          "function": {
            "functionId": "nextServerWest",
            "region": "us-west2"
          }
        }
      ]
    },
    {
      "target": "test",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": true,
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow, noarchive"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "function": {
            "functionId": "nextServerTestWest",
            "region": "us-west2"
          }
        }
      ]
    }
  ]
}
