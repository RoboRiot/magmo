# Copy this file to .env.test.local. That file is ignored by Git.
# The Firebase public app settings are applied automatically by testdeploy.ps1.

# Optional: credentials from the magmo-test Slack app.
SLACK_BOT_TOKEN=replace_with_magmo_test_bot_token
SLACK_SIGNING_SECRET=your-magmo-test-signing-secret

# Required: a staging-only value that is different from production.
# The test deploy also enforces read-only Ops API mode server-side.
OPS_INGEST_SECRET=replace_with_staging_only_ops_secret

# Recommended: keep test posts in a dedicated Slack channel.
SLACK_CHANNEL_ID=your_test_channel_id
SLACK_CHANNEL_NAME=magmo-test

# Add test-specific Slack List IDs/columns here if the test app uses Lists.
# SLACK_LIST_TASKS_ID=
# SLACK_LIST_TASKS_TITLE_COL=
# SLACK_LIST_TASKS_DESCRIPTION_COL=
# SLACK_LIST_SHIPPING_ID=
# SLACK_LIST_RECEIVING_ID=
# SLACK_LIST_TOOLS_ID=

# Optional overrides. Shared non-Slack service settings fall back to .env.local.
# OPS_TESTING_CHANNEL_ID=
# OPS_CONVERSATION_CHANNEL_ID=
