# Root envs
.env
.env.local
.env.*.local

# Keep an example to document variables
!.env.example

# Functions envs
functions/.env
functions/.env.local
functions/.env.*.local
# Keep example
!functions/.env.example

# Other local env/debug files
env_backup.txt
extensions/*.env
firebase-debug.log
5-6-2026_Test.json

# Generated Next.js build output
.next/
.next-test-*/
functions/.next/

# Dependencies and generated local artifacts
node_modules/
.tools/
scripts/__pycache__/
*.pyc
tmp-askmagmo-test-logs/

# Local warehouse-scanner deployment copies/backups can contain legacy private
# configuration and must never be committed.
outputs/scanner-runtime-staging/
outputs/scanner-backups/

# Local Windows-agent build mirror. Its installer payload embeds device
# bootstrap credentials and must not be committed with the web application.
magmonitor_agent_updates/
