# Firebase web config (browser-visible; restrict this key in Google Cloud)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
# Optional runtime alias used by the device-session token exchange.
FIREBASE_WEB_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=your_google_web_oauth_client_id

# Server-only credentials
BLUEFOLDER_API_TOKEN=your_bluefolder_token
BLUEFOLDER_BASE_URL=https://app.bluefolder.com/api/2.0
BLUEFOLDER_WORK_ORDERS_PATH=/serviceRequests/list.aspx
BLUEFOLDER_WORK_ORDER_DETAIL_PATH=/serviceRequests/get.aspx?serviceRequestId={id}
BLUEFOLDER_LIST_STATUS=open
BLUEFOLDER_STATUS_POLL_SECONDS=300
INFLOW_API_KEY=your_inflow_api_key
INFLOW_COMPANY_ID=your_inflow_company_id
MONDAY_API_TOKEN=your_monday_token
OPENAI_API_KEY=your_openai_api_key
SLACK_BOT_TOKEN=your_slack_bot_token
SLACK_USER_NAME_MAP=UAAAAAAA=Yao N,UBBBBBBB=Julian Ortiz

# Storage-unit Scan In bridge. Keep the bridge token server-only and use a
# different value in every environment. Production may derive start/stop paths
# from NGROK_BASE_URL; test/staging must use isolated exact URLs.
STORAGE_SCAN_ENABLED=false
STORAGE_SCAN_BRIDGE_TOKEN=replace_with_a_separate_secret_of_at_least_32_characters
STORAGE_SCAN_CALLBACK_BASE_URL=https://magmo.cloud
# STORAGE_SCAN_START_URL=https://scanner.example/storage-scan/start
# STORAGE_SCAN_STOP_URL=https://scanner.example/storage-scan/stop
# STORAGE_SCAN_DRAIN_URL=https://scanner.example/storage-scan/drain
# NGROK_BASE_URL=https://your-fixed-scanner-domain.example
STORAGE_SCAN_LOCAL_BASE_URL=http://127.0.0.1:5000
STORAGE_SCAN_SESSION_TTL_SECONDS=300
# Dedicated 4x6 bin/pallet label endpoint on that same authenticated server.
# PRINT_STORAGE_LABEL_PROXY_URL=https://scanner.example/print-storage-label
# PRINT_STORAGE_LABEL_LOCAL_URL=http://127.0.0.1:5000/print-storage-label
MAGMO_PUBLIC_ORIGIN=https://magmo.cloud
# Optional server-only Google Routes key. Without it, Ops-General requires the
# engineer to enter a manual ETA before starting a travel clock.
GOOGLE_MAPS_ROUTES_API_KEY=your_google_routes_api_key

# Ops API authentication. Required by slack_done_report_listener_v2.py for
# !complete, !parts, and !done; !daily can reply without an Ops write.
OPS_INGEST_SECRET=replace_with_a_long_random_secret
# MRI monitor agents use this server-only key when posting telemetry to MAGMO.
MAGMONITOR_INGEST_KEY=replace_with_a_separate_32_character_random_secret
CRON_SECRET=replace_with_a_different_long_random_secret
OPS_ASSIGNMENT_MODEL=gpt-5-nano
OPS_ASSIGNMENT_MAX_OUTPUT_TOKENS=340
OPS_PRIORITY_MIN_CONFIDENCE=0.72
OPS_REMOTE_MIN_CONFIDENCE=0.72
OPS_PRIORITY_REVIEW_BATCH_SIZE=2
OPS_SUMMARY_MODEL=gpt-5-nano
OPS_SUMMARY_MAX_OUTPUT_TOKENS=700
OPS_SUMMARY_REASONING_EFFORT=minimal
OPENAI_SERVICE_REPORT_MODEL=gpt-5-nano
OPENAI_SERVICE_REPORT_MAX_TOKENS=900
OPENAI_SERVICE_REPORT_REASONING_EFFORT=low

# Replacement BlueFolder listener - writes directly to Firestore
FIREBASE_ADMIN_SERVICE_ACCOUNT_PATH=C:/path/to/firebase-service-account.json
FIREBASE_PROJECT_ID=magmo-ac10c
FIREBASE_STORAGE_BUCKET=magmo-ac10c.appspot.com
FIREBASE_DATABASE_URL=https://magmo-ac10c-default-rtdb.firebaseio.com
OPS_TRACK_ASSIGNMENTS=true
OPS_DONE_FIREBASE_SYNC=true
OPS_DEFAULT_OVERSIGHT_SLACK_ID=U07FH9NKCSD
OPS_DEFAULT_OVERSIGHT_NAME=Igor Savchenko
OPS_DEFAULT_OVERSIGHT_EMAIL=isavchenko@advancedimagingparts.com
# Keep workflow/report commands owned by slack_done_report_listener_v2.py so
# the two local listeners cannot race or overwrite each other's summaries.
OPS_REPORT_COMMANDS_MANAGED_BY_DONE_LISTENER=true
# Website request client suggestions are generated immediately by Magmo. Leave
# the retired Python matcher disabled unless this listener is paired with an
# older Magmo build that does not write clientMatchSuggestionVersion.
OPS_LEGACY_SERVICE_REQUEST_MATCHING=false

# Read-only Google Search Console reporting
GOOGLE_SEARCH_CONSOLE_SITE_URL=sc-domain:advancedimagingparts.com
GOOGLE_SEARCH_CONSOLE_PUBLIC_ORIGIN=https://advancedimagingparts.com
# Optional: use a separate service account instead of FIREBASE_ADMIN_SERVICE_ACCOUNT_PATH.
# GOOGLE_SEARCH_CONSOLE_SERVICE_ACCOUNT_PATH=C:/path/to/search-console-service-account.json
# GOOGLE_SEARCH_CONSOLE_CLIENT_EMAIL=service-account@project.iam.gserviceaccount.com
# GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
OPS_TESTING_CHANNEL_ID=your_testing_slack_channel_id
OPS_DISPATCH_CHANNEL_ID=your_dispatch_slack_channel_id
OPS_DISPATCH_CHANNEL_NAME=dispatch
OPS_CONVERSATION_CHANNEL_ID=your_dispatch_slack_channel_id
OPS_THREAD_LOOKUP_WINDOW_SECONDS=3600
OPS_THREAD_LOOKUP_RETRY_SECONDS=30
OPS_PARENT_SCAN_SECONDS=300
OPS_MESSAGE_POLL_SECONDS=8
POLL_SECONDS=60
LISTENER_LOCK_FILE=./bluefolder_slack_listener_v2.lock
OPS_THREAD_SCAN_BATCH=4
# Device streams use a one-hour scoped Firebase session and Firestore telemetry
# is accepted at most once per system every 30 minutes.
MAGMONITOR_DEVICE_SESSION_TTL_SECONDS=3600
MAGMONITOR_INGEST_MIN_INTERVAL_MS=1800000
