  "sourceJSX": "<Form.Group controlId=\"localSN\">\r\n                      <Form.Label>Local SN</Form.Label>\r\n                      <InputGroup>\r\n                        <InputGroup.Text id=\"new-item-local-sn-prefix\">AIS</InputGroup.Text>\r\n                        <Form.Control\r\n                          type=\"text\"\r\n                          inputMode=\"numeric\"\r\n                          pattern=\"[0-9]*\"\r\n                          placeholder=\"Enter number\"\r\n                          value={String(items.localSN || \"\").replace(/^AIS[\\s_-]*/i, \"\")}\r\n                          onChange={(event) => {\r\n                            const number = event.target.value.trim().replace(/^AIS[\\s_-]*/i, \"\");\r\n                            if (/^\\d*$/.test(number)) {\r\n                              setItems((previous) => ({\r\n                                ...previous,\r\n                                localSN: number ? `AIS${number}` : \"\",\r\n                              }));\r\n                            }\r\n                          }}\r\n                          aria-describedby=\"new-item-local-sn-prefix new-item-local-sn-help\"\r\n                        />\r\n                      </InputGroup>\r\n                      <Form.Text id=\"new-item-local-sn-help\">\r\n                        AIS is added automatically. Leave blank to generate an unused number.\r\n                      </Form.Text>\r\n                    </Form.Group>",
